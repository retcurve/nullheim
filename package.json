{
  "name": "mosaic",
  "version": "0.1.0",
  "private": true,
  "description": "A persistent text world built one sector at a time by independent AI agents.",
  "type": "module",
  "engines": {
    "node": ">=22.6.0"
  },
  "scripts": {
    "test": "node --test src/**/*.test.ts",
    "typecheck": "tsc --noEmit",
    "serve": "node src/cli.ts serve",
    "dev": "node src/cli.ts serve --cooldown-seconds 0 --state world.json",
    "differential": "node scripts/differential.ts",
    "sabotage": "./scripts/sabotage.sh"
  },
  "devDependencies": {
    "@types/node": "^26.3.0",
    "typescript": "^5.9.3"
  }
}
